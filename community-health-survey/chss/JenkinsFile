pipeline {
    agent any

    parameters {
        string(
            name: 'TOMCAT_HOME',
            defaultValue: 'C:\\Users\\Jyotsna\\Downloads\\apache-tomcat-10.1.60',
            description: 'Tomcat installation directory used for deployment'
        )
        string(
            name: 'GIT_REVISION',
            defaultValue: 'main',
            description: 'Git branch, tag, or commit SHA to build'
        )
    }

    environment {
        // Keep the temporary test server separate from the local app (8081),
        // Jenkins (8082), and deployment Tomcat (8083).
        SELENIUM_PORT = '8181'
        SELENIUM_REPORTS_PUBLISHED = 'false'
    }

    stages {

        stage('Checkout') {
            steps {
                script {
                    // Keep the job's configured repository URL, credentials, and extensions,
                    // while selecting the requested branch, tag, or commit for this run.
                    def jobScm = scm
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: params.GIT_REVISION]],
                        doGenerateSubmoduleConfigurations: jobScm.doGenerateSubmoduleConfigurations,
                        extensions: jobScm.extensions,
                        gitTool: jobScm.gitTool,
                        submoduleCfg: jobScm.submoduleCfg,
                        userRemoteConfigs: jobScm.userRemoteConfigs
                    ])
                }
            }
        }

        stage('Build') {
            steps {
                bat 'call mvnw.cmd -f community-health-survey\\chss\\pom.xml clean test-compile'
            }
        }

        stage('Start Test Application') {
            steps {
                bat 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File community-health-survey\\chss\\scripts\\start-selenium-app.ps1 -Port %SELENIUM_PORT%'
            }
        }

        stage('Selenium Tests') {
            steps {
                script {
                    def seleniumExitCode
                    withEnv(["SELENIUM_BASE_URL=http://localhost:${env.SELENIUM_PORT}"]) {
                        seleniumExitCode = bat(
                            returnStatus: true,
                            script: 'call mvnw.cmd -f community-health-survey\\chss\\pom.xml test'
                        )
                    }
                    if (seleniumExitCode == null) {
                        error('Maven Selenium test process did not return an exit status.')
                    }
                    writeFile(
                        file: 'community-health-survey/chss/target/selenium-exit-code.txt',
                        text: seleniumExitCode.toString()
                    )
                    echo "Maven Selenium test process exited with code ${seleniumExitCode}."
                }
            }
        }

        stage('Publish Test Reports') {
            steps {
                junit testResults: 'community-health-survey/chss/target/surefire-reports/*.xml', allowEmptyResults: true
                archiveArtifacts artifacts: 'community-health-survey/chss/target/surefire-reports/*.xml,community-health-survey/chss/target/selenium-screenshots/**/*.png', allowEmptyArchive: true
                script {
                    env.SELENIUM_REPORTS_PUBLISHED = 'true'
                    int seleniumExitCode = readFile(
                        file: 'community-health-survey/chss/target/selenium-exit-code.txt'
                    ).trim().toInteger()
                    if (seleniumExitCode != 0) {
                        error("Selenium/Maven tests failed with exit code ${seleniumExitCode}; refusing to package or deploy.")
                    }
                }
            }
        }

        stage('Stop Test Application') {
            steps {
                bat 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File community-health-survey\\chss\\scripts\\stop-selenium-app.ps1'
            }
        }

        stage('Package') {
            steps {
                bat 'call mvnw.cmd -f community-health-survey\\chss\\pom.xml package -DskipTests'
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                    echo Deploying Community Health Survey System...

                    set "JAVA_HOME=C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.18.8-hotspot"
                    set "JRE_HOME=%JAVA_HOME%"
                    set "CATALINA_HOME=%TOMCAT_HOME%"

                    if not defined JAVA_HOME (
                        echo JAVA_HOME is empty; cannot start Tomcat.
                        exit /b 1
                    )

                    if not exist "%JAVA_HOME%" (
                        echo Java installation not found under "%JAVA_HOME%".
                        exit /b 1
                    )

                    if not exist "%JAVA_HOME%\\bin\\java.exe" (
                        echo Java executable not found under "%JAVA_HOME%\\bin".
                        exit /b 1
                    )

                    if not defined CATALINA_HOME (
                        echo TOMCAT_HOME is empty; cannot configure CATALINA_HOME.
                        exit /b 1
                    )

                    if not exist "%CATALINA_HOME%" (
                        echo Tomcat installation not found under "%CATALINA_HOME%".
                        exit /b 1
                    )

                    if not exist "%CATALINA_HOME%\\bin\\shutdown.bat" (
                        echo Tomcat shutdown script not found under "%CATALINA_HOME%".
                        exit /b 1
                    )

                    if not exist "%CATALINA_HOME%\\bin\\startup.bat" (
                        echo Tomcat startup script not found under "%CATALINA_HOME%".
                        exit /b 1
                    )

                    if not exist "%CATALINA_HOME%\\webapps" (
                        echo Tomcat webapps directory not found under "%CATALINA_HOME%".
                        exit /b 1
                    )

                    if not exist "community-health-survey\\chss\\target\\community-health-survey.war" (
                        echo Packaged WAR not found; refusing to deploy.
                        exit /b 1
                    )

                    powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$client = New-Object System.Net.Sockets.TcpClient; $listening = $false; try { $client.Connect('127.0.0.1', 8083); $listening = $true } catch { } finally { $client.Dispose() }; if ($listening) { exit 0 } else { exit 1 }"
                    if errorlevel 1 (
                        echo Tomcat is already stopped; skipping shutdown.
                    ) else (
                        call "%CATALINA_HOME%\\bin\\shutdown.bat" <NUL
                        if errorlevel 1 (
                            echo Tomcat shutdown failed.
                            exit /b 1
                        )
                        powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$stopped = $false; for ($i = 0; $i -lt 30; $i++) { $client = New-Object System.Net.Sockets.TcpClient; $listening = $false; try { $client.Connect('127.0.0.1', 8083); $listening = $true } catch { } finally { $client.Dispose() }; if (-not $listening) { $stopped = $true; break }; Start-Sleep -Seconds 1 }; if (-not $stopped) { Write-Error 'Tomcat did not stop listening on port 8083'; exit 1 }"
                        if errorlevel 1 exit /b 1
                    )

                    if exist "%CATALINA_HOME%\\webapps\\community-health-survey.war" (
                        del /Q "%CATALINA_HOME%\\webapps\\community-health-survey.war"
                        if errorlevel 1 exit /b 1
                    )

                    if exist "%CATALINA_HOME%\\webapps\\community-health-survey" (
                        rmdir /S /Q "%CATALINA_HOME%\\webapps\\community-health-survey"
                        if errorlevel 1 exit /b 1
                    )

                    copy /Y "community-health-survey\\chss\\target\\community-health-survey.war" "%CATALINA_HOME%\\webapps\\community-health-survey.war"
                    if errorlevel 1 exit /b 1

                    echo WAR deployed successfully.

                    call "%CATALINA_HOME%\\bin\\startup.bat" <NUL
                    if errorlevel 1 (
                        echo Tomcat startup failed.
                        exit /b 1
                    )

                    powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ready = $false; for ($i = 0; $i -lt 90; $i++) { $client = New-Object System.Net.Sockets.TcpClient; try { $client.Connect('127.0.0.1', 8083); $ready = $true } catch { } finally { $client.Dispose() }; if ($ready) { break }; Start-Sleep -Seconds 1 }; if (-not $ready) { Write-Error 'Tomcat did not start listening on port 8083 within 90 seconds'; exit 1 }"
                    if errorlevel 1 exit /b 1

                    echo Checking Tomcat deployment...
                    powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference = 'Stop'; $deadline = (Get-Date).AddSeconds(60); $verified = $false; $lastError = 'No successful 2xx response received'; do { try { $r = Invoke-WebRequest -Uri 'http://localhost:8083/community-health-survey/' -UseBasicParsing -TimeoutSec 5; if ($r.StatusCode -ge 200 -and $r.StatusCode -lt 300) { Write-Host ('HTTP Status: ' + $r.StatusCode); $verified = $true; break }; $lastError = 'Unexpected HTTP status: ' + $r.StatusCode } catch { $lastError = $_.Exception.Message }; if (-not $verified) { Start-Sleep -Seconds 2 } } while ((Get-Date) -lt $deadline); if (-not $verified) { Write-Error ('Deployment check failed: ' + $lastError); exit 1 }"
                    if errorlevel 1 exit /b 1
                '''
            }
        }
    }

    post {
        always {
            bat 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File community-health-survey\\chss\\scripts\\stop-selenium-app.ps1'
            script {
                if (env.SELENIUM_REPORTS_PUBLISHED != 'true') {
                    junit testResults: 'community-health-survey/chss/target/surefire-reports/*.xml', allowEmptyResults: true
                    archiveArtifacts artifacts: 'community-health-survey/chss/target/surefire-reports/*.xml,community-health-survey/chss/target/selenium-screenshots/**/*.png', allowEmptyArchive: true
                }
            }
        }

        success {
            echo 'Community Health Survey System deployed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
